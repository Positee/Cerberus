# Copy this file to .env and fill in DATABASE_URL.
#
# Get the connection string from the Neon console:
#   Project -> Connection Details -> Connection string (pooled).
# It looks like:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/cerberus?sslmode=require
#
# Never commit the real .env file. It is listed in .gitignore.

DATABASE_URL=

# The API listens here. The Vite dev server proxies /api to this port.
PORT=4000

NODE_ENV=development

# The browser origin allowed to send credentialed requests.
WEB_ORIGIN=http://localhost:5173
